# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session & Security
SESSION_SECRET="super-secret-session-key-minimum-32-chars-long"
COOKIE_DOMAIN=""
COOKIE_SECURE=false

# Initial Admin Bootstrap
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@college.edu"
ADMIN_INITIAL_PASSWORD="Admin@SecurePassword2026!"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Email Delivery (SMTP / Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@college.edu"
SMTP_PASS="your-app-password"
EMAIL_FROM="College Community <notifications@college.edu>"
ADMIN_NOTIFICATION_EMAIL="facilities@college.edu"

# Telegram Bot (Lab Complaints)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"

# AI Service (Timetable Extraction & Study Plan)
# Providers: GEMINI, OPENAI, MOCK
AI_PROVIDER="MOCK"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Storage Configuration (LOCAL, S3, CLOUDINARY)
STORAGE_DRIVER="LOCAL"
UPLOAD_DIR="./uploads"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
